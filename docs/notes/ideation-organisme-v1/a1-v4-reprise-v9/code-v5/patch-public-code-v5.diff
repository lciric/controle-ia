+        with self.assertRaises(a5.AttaqueRefusee):
+            a5.carte_w2g(G, -1, 0.5)
+        with self.assertRaisesRegex(a5.AttaqueRefusee, "dose"):
+            a5.carte(G, 0, "W2", 0.5)
+        with self.assertRaisesRegex(a5.AttaqueRefusee, "dose"):
