+        self.assertNotEqual(c1["verite"]["N"], c3["verite"]["N"])
+        self.assertEqual(c1["verite"]["N"], c1["L"]["N"], "N est la loi neuve de la carte (banc_tricheurs_v7._monde_lois)")
+        for d in (0.05, 0.3, 1.0):
+            loi = carte_w2g(0, d)["monde"]
