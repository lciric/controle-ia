+
+MUTATIONS = [
+    # --- monde W2 gradué ---
+    ("dose nulle rendue en mélange (W2 non à l'octet)", a5, "monde_w2g", "    if d == 0.0:\n        return ag.monde_w2(L)\n",
+     "    if False:\n        return ag.monde_w2(L)\n", [MON + "test_cas_sain_dose_nulle_est_w2_a_l_octet"], r"!= |N manque"),
