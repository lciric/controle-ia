+    ("W2 lu par la lecture de W2g", a5, "lire_monde", "    if monde == \"W2\":\n", "    if False:\n",
+     [LEC + "test_lire_delegue_w2_a_la_v4_et_refus"], r"AttaqueRefusee|monde W2g seulement"),
+    # --- lanceur v5 ---
