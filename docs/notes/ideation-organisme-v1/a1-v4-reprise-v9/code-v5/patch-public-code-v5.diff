+     [MON + "test_artefacts_dose_graine_monde"], NR + r"|TypeError"),
+    ("cartes de W2g tirées de la graine de W2 (collision des mondes)", a5, "carte_w2g", "ag.graine(entropie, \"monde|W2g\", c)",
