+
+def garde_5(rapport):
+    motifs = []
+    for r in rapport["resultats"]:
+        a, b = r["lignes"]["monde|v9"]["promues"], r["lignes"]["recombinaison|v9"]["promues"]
+        if r["dose"] == 0 and a > 0:
