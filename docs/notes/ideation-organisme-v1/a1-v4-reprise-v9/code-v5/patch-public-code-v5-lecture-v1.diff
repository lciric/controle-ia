+    if not ((lam is None and imprime is None) or (lam is not None and _nombre(imprime) and imprime == lam)):
+        motifs.append(("desaccord_lambda", f"λ* imprimé par le script {imprime!r}, recalculé {lam!r}"))
+    if motifs:
