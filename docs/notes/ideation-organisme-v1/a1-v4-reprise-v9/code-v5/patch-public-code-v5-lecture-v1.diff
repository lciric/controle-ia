+        try:
+            empreinte = ecrire_json_scelle(args.lecture, refus)
+            print(f"lecture (arrêt de garde) {os.path.abspath(args.lecture)} sha256 {empreinte}", file=sys.stderr)
+        except OSError as erreur:
