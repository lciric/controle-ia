+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m
+
+
+lecteur = _charger("lecture_epreuve_w2g_dose_v1.py", "lecture_epreuve_w2g_dose_v1_essai")
+
