+    for ligne in t1.splitlines():
+        m = _LIGNE_TABLE.match(ligne)
+        if m and " ; " in m.group(3):
+            niveaux[m.group(2).strip()] = m.group(3).count(" ; ") + 1
+    bloc = sorted((n for n in noms if niveaux.get(n) == niveaux.get(nom)), key=lambda n: noms[n])
+    return bloc.index(nom) / max(1, len(bloc) - 1)
