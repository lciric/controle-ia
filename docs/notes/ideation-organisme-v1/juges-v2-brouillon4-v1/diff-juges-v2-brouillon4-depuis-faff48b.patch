+
+def _trait_rang_relatif(c, dossier):
+    nom, noms = _nom_principal(c, dossier)
+    if nom is None:
+        return None
+    t1 = str(dossier or "").split("### Table 2")[0]
+    niveaux = {}
+    for _, n in _RE_LIGNE_T1_NOM.findall(t1):  # nombre de niveaux : lignes (ancien format) ou cellules (format à une ligne)
+        n = n.strip()
