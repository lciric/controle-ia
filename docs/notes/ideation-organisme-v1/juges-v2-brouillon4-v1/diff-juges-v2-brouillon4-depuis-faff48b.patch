+def lire_releve(texte):
+    """Bloc `releve-epreuve` (brouillon 4, I11, I12) : exigé, sans marqueur, clés `CLES_RELEVE` ; prix d'Argon au plus
+    `PRIX_EPREUVE_JUGE_A_MAX_USD` ; lignes de 413 reconnues par `_REQUETE`. Rend le relevé (dict) ou lève
+    `PreenregistrementRefuse`."""
+    corps = _bloc(texte, DEBUT_RELEVE, FIN_RELEVE, "releve-epreuve")
+    if MARQUEUR.search(corps) or not corps.strip():
+        raise PreenregistrementRefuse("relevé de l'épreuve des commandes non rempli (marqueur « À REMPLIR » du bloc releve-epreuve) : "
+                                      "épreuve à faire et à recopier avant le scellement")
+    releve = {}
+    for l in corps.splitlines():
+        m = re.match(r"^\s*([a-z0-9_]+)\s*:\s*(.+?)\s*$", l)
+        if m:
+            releve[m.group(1)] = m.group(2)
+    manquantes = [k for k in CLES_RELEVE if k not in releve]
+    if manquantes:
+        raise PreenregistrementRefuse(f"relevé de l'épreuve : clés manquantes {manquantes}")
+    try:
+        prix = float(releve["prix_comparaison_argon_usd"].replace(",", "."))
+    except ValueError:
+        raise PreenregistrementRefuse("relevé de l'épreuve : prix_comparaison_argon_usd illisible") from None
+    if not (math.isfinite(prix) and prix > 0):
+        raise PreenregistrementRefuse("relevé de l'épreuve : prix_comparaison_argon_usd > 0 exigé")
+    if prix > PRIX_EPREUVE_JUGE_A_MAX_USD + 1e-12:
+        raise PreenregistrementRefuse(f"relevé de l'épreuve : comparaison d'Argon à {prix:g} USD, au-delà de "
+                                      f"{PRIX_EPREUVE_JUGE_A_MAX_USD:g} USD (la part de 24 USD ne laisse plus la moitié de la marge "
+                                      "d'incidents) : arrêt, nouveau texte (I12)")
