#!/usr/bin/env bash
# faux outil : état dans $ETAT_FAUX, journal dans $JOURNAL_FAUX, arrêts dans $ARRETS_FAUX ; MONTRER_ECHEC=1 : « show » échoue
case "$1 $2" in
  "show instance") [ -n "$MONTRER_ECHEC" ] && exit 1; echo "{\"actual_status\": \"$(cat "$ETAT_FAUX")\", \"cur_state\": \"$(cat "$ETAT_FAUX")\", \"dph_total\": 2.4, \"status_msg\": \"\"}" ;;
  "logs "*) cat "$JOURNAL_FAUX" ;;
  "stop instance") echo "$3" >> "$ARRETS_FAUX"; echo stopped > "$ETAT_FAUX"; echo "arrêt demandé" ;;
esac
