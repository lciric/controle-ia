+            releve, journal = B.jouer_boucle(args.sortie, monde=monde, jeu=jeu, heritage_depart=heritage_depart, racine=entropie,
+                                             plan=plan, decisions=decisions, proposeurs=proposeurs, adaptateur_etage=adaptateur,
