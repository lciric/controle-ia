+        cartes = [T.carte_servie(T.identifiant_opaque(RACINE_GRAINES, tache, f"c{k}"), loi, "essai")
+                  for k, loi in enumerate([JEU["vraies"]["V1"], JEU["vraies"]["V2"], JEU["fausses"]["F2"]])]
