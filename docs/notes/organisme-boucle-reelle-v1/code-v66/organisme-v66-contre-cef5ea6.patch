+def _plan(**chg):
+    p = dict(PLAN_SAIN, **chg)
+    return LANCEUR.DEBUT_PLAN + "\n" + "\n".join(f"{k}: {v}" for k, v in p.items() if v is not None) + "\n" + LANCEUR.FIN_PLAN
